package-as: RGXQoL

enable-nolib-creation: no

# Directory entries have no trailing slash (the packager matcher treats "docs" and "docs/" differently).
ignore:
  - .gitignore
  - .gitlab-ci.yml
  - .github
  - AGENTS.md
  - README.md
  - docs
  - .pkgmeta

required-dependencies:
  - rgx-framework

optional-dependencies:
  - elvui

manual-changelog:
  filename: Changelog.txt
  markup-type: text
